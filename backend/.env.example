# MongoDB connection string
# Option 1: Use a local MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/avio-training-management

# Option 2: Use MongoDB Atlas (remote cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Option 3: Leave blank/undefined to automatically start a zero-setup local in-memory database
# MONGODB_URI=

NODE_ENV=production
JWT_SECRET=your_jwt_secret_here
PORT=3000

